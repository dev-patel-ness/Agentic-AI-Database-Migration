# Environment variables
.env
.env.local
.env.*.local
.env.prod
*.pem
*.key

# CrackSQL adapter runtime state (Flask instance dir/sqlite db, logs) --
# regenerated on first call, never committed.
tool_adapters/cracksql_adapter/instance/
tool_adapters/cracksql_adapter/logs/

# CrackSQL adapter: per-run job output JSON files (timestamped translation
# results written during live runs -- useful locally but not source code).
tool_adapters/cracksql_adapter/*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_*.json

# CrackSQL vendored source: build artifact regenerated by build_editable.py,
# never committed.
tool_adapters/cracksql_adapter/vendor/CrackSQL/_package_build/
tool_adapters/cracksql_adapter/vendor/CrackSQL/build/
tool_adapters/cracksql_adapter/vendor/CrackSQL/cracksql.egg-info/

# SeaTunnel adapter: generated per-job HOCON configs (written then deleted
# after each job runs, but ignore the dir in case one is left behind).
tool_adapters/seatunnel_adapter/jobs/

# JDBC driver jars for the seatunnel image -- redistribution terms vary per
# vendor; fetched by infra/docker/seatunnel/fetch_jdbc_drivers.ps1 instead.
infra/docker/seatunnel/jars/
infra/docker/seatunnel/connectors/

# Ad-hoc script/poetry output dumped to a file, never committed.
test_output.txt
poetry_install.log


